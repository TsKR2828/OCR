[
  {
    "start": 72.72,
    "end": 75.74,
    "text": "我這現在偷吃餅乾一定不會有人發現",
    "no_speech_prob": 0.06689453125,
    "language": "zh"
  },
  {
    "start": 78.2,
    "end": 79.72,
    "text": "我的洋芋片",
    "no_speech_prob": 0.06689453125,
    "language": "zh"
  },
  {
    "start": 79.72,
    "end": 143.44,
    "text": "我還是被發現了",
    "no_speech_prob": 0.06689453125,
    "language": "zh"
  },
  {
    "start": 161.51,
    "end": 164.01,
    "text": "等我一下阿桃 等一下阿草",
    "no_speech_prob": 0.06689453125,
    "language": "zh"
  },
  {
    "start": 164.01,
    "end": 166.74,
    "text": "它跑掉了",
    "no_speech_prob": 0.06689453125,
    "language": "zh"
  },
  {
    "start": 166.74,
    "end": 185.6,
    "text": "草仔 expected",
